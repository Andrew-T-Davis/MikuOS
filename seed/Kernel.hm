U8* VRAM = 0xA0000;
U8* VGAFont = 0xFFA6E;

Struct IDTR {
    U16 Size;
    U64 Addr;
};

Struct IDTEntry {
    U16 OffsetLow;
    U16 Selector;
    U8  IST;
    U8  TypeAttr;
    U16 OffsetMid;
    U32 OffsetHigh;
    U32 Rsvd0;
};

IDTR GlobalIDT;
IDTEntry GlobalIDTTables[256];

U8 SEL_PM_CODE = 0x08
U8 SEL_PM_DATA = 0x10
U8 SEL_LM_CODE = 0x18
U8 SEL_LM_DATA = 0x20

U8* Hex4Bit="0123456789ABCDEF";

U64 EntryAddr=0;

Func U0 KernelMain(){
    RDTSC;
    U64 LoopTime=5;
    Loop5TimeOut0:
    LoopTime=LoopTime-1;
    PUSHQ QAX;
    PUSHQ QDX;
    MOVW WDX, 0x3F8;
    MOVB BAL, 48;
    OUTB WDX, BAL;
    POPQ QDX;
    POPQ QAX;
    If (LoopTime>0) Goto Loop5TimeOut0;
    
    HM_Out3F8(0x30);

    VGAText("MikuOS v0.001",0,0,0b1001);
    VGAText("By Andrew T. Davis",0,8,0b1010);
    VGAText("Test IDT",0,16,0b1100);
    InitIDT();
    U32 ReadTSC=0;
    RDTSC;
    PUSHD DAX;
    PUSHD DDX;
    U32 RDTSC_LOW=0;
    U32 RDTSC_HIGH=0;
    POPD DDX;
    POPD DAX;
    MOVD [RDTSC_LOW],DAX;
    MOVD [RDTSC_HIGH],DDX;
    VGAText("Main While",0,24,0b0011);
    VGAText("A", 0, 0, 0x0F);
    VGAText("B", 8, 0, 0x0F);
    VGAText("C", 16, 0, 0x0F);

    Print3F8("Main While");HM_Out3F8(0xA);
    While (1){
        PAUSE;
    }
    Return;
}

Func U0 SetIDTEntry(IDTEntry* entry, U64 handler) {
    CLI;

    entry->OffsetLow  = handler;
    entry->Selector   = 0x18;
    entry->IST        = 0;
    entry->TypeAttr   = 0x8E;
    entry->OffsetMid  = handler >> 16;
    entry->OffsetHigh = handler >> 32;
    entry->Rsvd0      = 0;

    Return;
}

Func U0 InitIDT(){
    Print3F8("Enter InitIDT");HM_Out3F8(0xA);
    GlobalIDT.Addr=&GlobalIDTTables;
    GlobalIDT.Size=(SizeOf(IDTEntry)*256)-1;
    Print3F8("Set GlobalIDT");HM_Out3F8(0xA);
    
    U64 TestAddr=&Test;
    SetIDTEntry(&GlobalIDTTables[0],TestAddr);
    Print3F8("Set IDT[0]");HM_Out3F8(0xA);
        
    LIDT [GlobalIDT];
    Print3F8("Load IDT");HM_Out3F8(0xA);
    
    Print3F8("Try INT 0x0");HM_Out3F8(0xA);
    INT 0;
    Print3F8("Finish");HM_Out3F8(0xA);
    Return;
}

Func Naked U0 Test(){
    CLI;
    Print3F8("Int 0x0");HM_Out3F8(0xA);
    STI;
    IRETQ;
}

Func U0 VGA_SetGC(U8 Index, U8 Value){
    HM_OutB(0x3CE, Index);
    HM_OutB(0x3CF, Value);
    Return;
}

Func U0 VGAPixel(U16 X, U16 Y, U8 Color){
    VGA_SetGC(0x00, Color);
    VGA_SetGC(0x01, 0x0F);

    U16 Offset = (Y * 80) + (X >> 3);

    U8 PixelMask = 0x80 >> (X & 7);
    VGA_SetGC(0x08, PixelMask);

    U8 Dummy = VRAM[Offset];
    VRAM[Offset] = Dummy;

    VGA_SetGC(0x01, 0x00);
    VGA_SetGC(0x08, 0xFF);
    Return;
}

Func U0 VGARectFill(U16 X, U16 Y, U16 W, U16 H, U8 Color){
    If (W == 0 || H == 0) Return;

    VGA_SetGC(0x00, Color);
    VGA_SetGC(0x01, 0x0F);

    U16 X2 = X + W - 1;
    U16 StartByte = X >> 3;
    U16 EndByte = X2 >> 3;

    U8 StartMask = 0xFF >> (X & 7);
    U8 EndMask = 0xFF << (7 - (X2 & 7));

    U16 Row = 0;
    While (Row < H) {
        U16 BaseOffset = ((Y + Row) * 80);

        If (StartByte == EndByte) {
            U8 SingleMask = StartMask & EndMask;
            VGA_SetGC(0x08, SingleMask);
            U8 Dummy = VRAM[BaseOffset + StartByte];
            VRAM[BaseOffset + StartByte] = Dummy;
        } 
        Else {
            If (StartMask != 0xFF) {
                VGA_SetGC(0x08, StartMask);
                U8 DummyL = VRAM[BaseOffset + StartByte];
                VRAM[BaseOffset + StartByte] = DummyL;
                StartByte = StartByte + 1;
            }

            VGA_SetGC(0x08, 0xFF);
            U16 ByteIdx = StartByte;
            While (ByteIdx < EndByte) {
                U8 DummyM = VRAM[BaseOffset + ByteIdx];
                VRAM[BaseOffset + ByteIdx] = DummyM;
                ByteIdx = ByteIdx + 1;
            }

            StartByte = X >> 3;

            If (EndMask != 0x00) {
                VGA_SetGC(0x08, EndMask);
                U8 DummyR = VRAM[BaseOffset + EndByte];
                VRAM[BaseOffset + EndByte] = DummyR;
            }
        }

        Row = Row + 1;
    }

    VGA_SetGC(0x01, 0x00);
    VGA_SetGC(0x08, 0xFF);
    Return;
}

Func U0 VGARect(U16 X, U16 Y, U16 W, U16 H, U8 Color){
    If (W == 0 || H == 0) Return;

    VGARectFill(X, Y, W, 1, Color);

    If (H > 1) {
        VGARectFill(X, Y + H - 1, W, 1, Color);
    }

    If (H > 2) {
        VGA_SetGC(0x00, Color);
        VGA_SetGC(0x01, 0x0F);

        U16 LeftOffset = X >> 3;
        U8  LeftMask = 0x80 >> (X & 7);

        U16 RightX = X + W - 1;
        U16 RightOffset = RightX >> 3;
        U8  RightMask = 0x80 >> (RightX & 7);

        U16 Row = 1;
        While (Row < H - 1) {
            U16 BaseOffset = (Y + Row) * 80;

            VGA_SetGC(0x08, LeftMask);
            U8 DummyL = VRAM[BaseOffset + LeftOffset];
            VRAM[BaseOffset + LeftOffset] = DummyL;

            VGA_SetGC(0x08, RightMask);
            U8 DummyR = VRAM[BaseOffset + RightOffset];
            VRAM[BaseOffset + RightOffset] = DummyR;

            Row = Row + 1;
        }

        VGA_SetGC(0x01, 0x00);
        VGA_SetGC(0x08, 0xFF);
    }

    Return;
}

Func U0 VGAText(U8* String, U16 X, U16 Y, U8 Color){
    VGA_SetGC(0x00, Color);
    VGA_SetGC(0x01, 0x0F);
    VGA_SetGC(0x03, 0x00);
    VGA_SetGC(0x05, 0x00);
    VGA_SetGC(0x08, 0xFF);

    While(*String){
        U8* CharROM = 0xFFA6E + ((*String) * 8);
        U16 Row = 0;

        U16 ByteX = X >> 3;
        U8  BitShift = X & 7;

        While(Row < 8){
            U16 BaseOffset = ((Y + Row) * 80) + ByteX - 1;
            U8 Pattern = CharROM[Row];

            U8 Mask1 = Pattern >> BitShift;
            If (Mask1) {
                VGA_SetGC(0x08, Mask1);
                U8 Dummy1 = VRAM[BaseOffset];
                VRAM[BaseOffset] = Dummy1;
            }

            If (BitShift) {
                U8 Mask2 = Pattern << (8 - BitShift);
                If (Mask2) {
                    VGA_SetGC(0x08, Mask2);
                    U8 Dummy2 = VRAM[BaseOffset + 1];
                    VRAM[BaseOffset + 1] = Dummy2;
                }
            }

            Row = Row + 1;
        }

        X = X + 8;
        String = String + 1;
    }

    VGA_SetGC(0x01, 0x00);
    VGA_SetGC(0x08, 0xFF);
    Return;
}

Func U0 HM_OutB(U16 Port, U8 Value){
    PUSHQ QDX;
    PUSHQ QAX;
    MOVW WDX, [Port];
    MOVB BAL, [Value];
    OUTB WDX, BAL;
    POPQ QAX;
    POPQ QDX;
    Return;
}

Func U0 HM_Out3F8(U8 Value){
    PUSHQ QAX;
    PUSHQ QDX;
    MOVW WDX, 0x3F8;
    MOVB BAL, [Value];
    OUTB WDX, BAL;
    POPQ QDX;
    POPQ QAX;
    Return;
}

Func U0 Print3F8(U8* String){
    While (*String) {
        HM_Out3F8(*String);
        String = String + 1;
    }
    Return;
}