U8* VRAM = 0xA0000;
U8* VGAFont = 0xFFA6E;

Struct IDTR {
    U16 Size;
    U64 Addr;
};

Struct IDTEntry {
    U16 OffsetLow;
    U16 Selector;
    U8  IST;
    U8  TypeAttr;
    U16 OffsetMid;
    U32 OffsetHigh;
    U32 Rsvd0;
};

IDTR GlobalIDT;
IDTEntry GlobalIDTTables[256];

U8 SEL_PM_CODE = 0x08
U8 SEL_PM_DATA = 0x10
U8 SEL_LM_CODE = 0x18
U8 SEL_LM_DATA = 0x20

Func U64 main(){
    U64 LoopTime=5;
    Loop5TimeOut0:
    LoopTime=LoopTime-1;
    PUSHQ QAX;
    PUSHQ QDX;
    MOVW WDX, 0x3F8;
    MOVB BAL, 48;
    OUTB WDX, BAL;
    POPQ QDX;
    POPQ QAX;
    If (LoopTime>0) Goto Loop5TimeOut0;
    HM_Out3F8(0xA);Print3F8("Hello World");HM_Out3F8(0xA);
    PrintVGA("MikuOS v0.001",0,0);
    PrintVGA("By Andrew T. Davis",0,8);
    InitIDT();
    While (1);
    Return;
}

Func U0 SetIDTEntry(IDTEntry* entry, U64 handler) {
    CLI;

    entry->OffsetLow  = handler;
    entry->Selector   = 0x18;
    entry->IST        = 0;
    entry->TypeAttr   = 0x8E;
    entry->OffsetMid  = handler >> 16;
    entry->OffsetHigh = handler >> 32;
    entry->Rsvd0      = 0;

    Return;
}

Func U0 InitIDT(){
    Print3F8("Enter InitIDT");HM_Out3F8(0xA);
    GlobalIDT.Addr=&GlobalIDTTables;
    GlobalIDT.Size=(SizeOf(IDTEntry)*256)-1;
    Print3F8("Set GlobalIDT");HM_Out3F8(0xA);
    
    U64 TestAddr=&Test;
    SetIDTEntry(&GlobalIDTTables[0],TestAddr);
    Print3F8("Set IDT[0]");HM_Out3F8(0xA);
        
    LIDT [GlobalIDT];
    Print3F8("Load IDT");HM_Out3F8(0xA);
    
    Print3F8("Try INT 0x0");HM_Out3F8(0xA);
    INT 0;
    Print3F8("Finish");HM_Out3F8(0xA);
    Return;
}

Func Naked U0 Test(){
    Print3F8("Int 0x0");HM_Out3F8(0xA);
    IRETQ;
}

Func U0 HM_OutB(U16 Port, U8 Value){
    PUSHQ QDX;
    PUSHQ QAX;
    MOVW WDX, [Port];
    MOVB BAL, [Value];
    OUTB WDX, BAL;
    POPQ QAX;
    POPQ QDX;
    Return;
}

Func U0 HM_Out3F8(U8 Value){
    PUSHQ QAX;
    PUSHQ QDX;
    MOVW WDX, 0x3F8;
    MOVB BAL, [Value];
    OUTB WDX, BAL;
    POPQ QDX;
    POPQ QAX;
    Return;
}

Func U0 Print3F8(U8* String){
    While (*String) {
        HM_Out3F8(*String);
        String = String + 1;
    }
    Return;
}

Func U0 PrintVGA(U8* String, U16 X, U16 Y){
    While (*String) {
        U8* CharROM = 0xFFA6E + ((*String) * 8);
        VRAM[((Y+0)*(640/8))+X]=CharROM[0];
        VRAM[((Y+1)*(640/8))+X]=CharROM[1];
        VRAM[((Y+2)*(640/8))+X]=CharROM[2];
        VRAM[((Y+3)*(640/8))+X]=CharROM[3];
        VRAM[((Y+4)*(640/8))+X]=CharROM[4];
        VRAM[((Y+5)*(640/8))+X]=CharROM[5];
        VRAM[((Y+6)*(640/8))+X]=CharROM[6];
        VRAM[((Y+7)*(640/8))+X]=CharROM[7];
        X = X + 1;
        String = String + 1;
    }
    Return;
}
